      <floats-group id="article-165569.s18">
        <fig id="article-165569.image.f1" position="float" orientation="portrait">
          <caption>
            <p>Interpretation of Tuberculin Skin Testing in Children. Contributed by D Tristram, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="Interpretation__of__TB__Children" position="float" orientation="portrait"/>
        </fig>
