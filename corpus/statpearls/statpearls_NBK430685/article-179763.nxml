<p>No adjustment</p>
</td>
                <td rowspan="1" colspan="1">
<p>No adjustment</p>
</td>
                <td rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Limited experience</p></list-item><list-item><p>Use with caution and monitoring</p></list-item></list>
