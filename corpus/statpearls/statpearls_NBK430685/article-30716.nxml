</p>
          </list-item>
        </list>
      </sec>
    </body>
    <back>
      <ref-list id="article-30716.s15">
        <title>References</title>
        <ref id="article-30716.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Uzzaman</surname>
                <given-names>A</given-names>
              </name>
              <name>
                <surname>Cho</surname>
