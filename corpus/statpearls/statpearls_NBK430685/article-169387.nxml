      <floats-group id="article-169387.s17">
        <fig id="article-169387.image.f4" position="float" orientation="portrait">
          <caption>
            <p>Type I Laryngeal Cleft Undergoing Repair. Note the opposing surfaces denuded of mucosa. Contributed by R De Jong, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="LC__treatment__pre__suture" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="article-169387.s18">
        <fig id="article-169387.image.f5" position="float" orientation="portrait">
          <caption>
            <p>Type I Laryngeal Cleft After Endoscopic Repair With Sutures. This technique is appropriate for all type I and II clefts, and most type III clefts; there have been reports of repairing type IV clefts in this manner, but this is not common. Contributed by R De Jong, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="LC__treatment__post__suture" position="float" orientation="portrait"/>
