                <td style="width: 186px; height: 13px;" rowspan="1" colspan="1">Chest wall</td>
                <td style="width: 430px; height: 13px;" rowspan="1" colspan="1">Pectus carinatum&#x000a0;or pectus&#x000a0;excavatum</td>
                <td style="width: 384.802px; height: 13px;" rowspan="1" colspan="1">Broad thorax</td>
              </tr>
