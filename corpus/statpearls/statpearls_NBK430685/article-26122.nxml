              <tr style="height: 13px;">
                <td style="height: 13px; width: 161.448px;" rowspan="1" colspan="1">Immune recovery uveitis</td>
                <td style="height: 13px; width: 414.552px;" rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Anterior uveitis</p></list-item><list-item><p>Vitritis</p></list-item><list-item><p>Cystoid macular edema</p></list-item><list-item><p>Retinal vasculitis</p></list-item><list-item><p>Epiretinal membrane due to recovery of the immune response after HAART</p></list-item></list>
</td>
              </tr>
              <tr style="height: 13px;">
                <td style="height: 13px; width: 161.448px;" rowspan="1" colspan="1">Adverse drug reactions</td>
                <td style="height: 13px; width: 414.552px;" rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Uveitis due to rifabutin or cidofovir</p></list-item><list-item><p>Peculiar patchy areas of peripheral chorioretinal atrophy due to didanosine</p></list-item><list-item><p>Maculopathy and macular outer retinal atrophy due to ritonavir</p></list-item><list-item><p>Visual hallucinations in the first weeks of starting efavirenz&#x000a0;<xref ref-type="bibr" rid="article-26122.r12">[12]</xref></p></list-item><list-item><p>Stevens-Johnson syndrome&#x000a0;<xref ref-type="bibr" rid="article-26122.r13">[13]</xref></p></list-item></list>
</td>
              </tr>
