                <td style="height: 13px;" rowspan="1" colspan="1">Mild</td>
              </tr>
              <tr style="height: 13px;">
                <td style="height: 13px;" rowspan="1" colspan="1">3-5</td>
                <td style="height: 13px;" rowspan="1" colspan="1">Moderate</td>
              </tr>
              <tr style="height: 13px;">
                <td style="height: 13px;" rowspan="1" colspan="1">6-11</td>
                <td style="height: 13px;" rowspan="1" colspan="1">Severe</td>
              </tr>
