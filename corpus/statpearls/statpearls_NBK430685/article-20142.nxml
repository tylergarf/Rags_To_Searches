        <table-wrap id="article-20142.table1" position="float" orientation="portrait">
          <caption>
            <title>Table 2. Westley Score Defining the Severity of Croup</title>
          </caption>
          <table style="width: 400px;" border="1" cellspacing="1" cellpadding="4">
            <tbody>
