</p>
          </list-item>
        </list>
      </sec>
    </body>
    <back>
      <ref-list id="article-27066.s9">
        <title>References</title>
        <ref id="article-27066.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <article-title>Notes for guidance on the clinical administration of radiopharmaceuticals and use of sealed radioactive sources. Administration of Radioactive Substances Advisory Committee.</article-title>
            <source>Nucl Med Commun</source>
            <year>2000</year>
            <month>Jan</month>
            <volume>21 Suppl</volume>
