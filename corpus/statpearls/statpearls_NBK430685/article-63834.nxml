    <book-part-meta>
      <title-group>
        <title>Medical Simulation Center Director as a System Improvement Leader</title>
      </title-group>
      <contrib-group>
        <contrib contrib-type="author">
          <name name-style="western">
            <surname>Pruden</surname>
            <given-names>Carla</given-names>
