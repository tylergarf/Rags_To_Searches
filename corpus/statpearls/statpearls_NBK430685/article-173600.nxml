        <ref id="article-173600.r9">
          <label>9</label>
          <element-citation publication-type="journal">
            <article-title>Fluvoxamine for the treatment of anxiety disorders in children and adolescents. The Research Unit on Pediatric Psychopharmacology Anxiety Study Group.</article-title>
            <source>N Engl J Med</source>
            <year>2001</year>
            <month>Apr</month>
            <day>26</day>
