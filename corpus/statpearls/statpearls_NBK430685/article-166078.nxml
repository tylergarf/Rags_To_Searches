<bold>Xanthogranulomatous Pyelonephritis</bold>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">Flank pain</td>
                <td rowspan="1" colspan="1">Present</td>
                <td rowspan="1" colspan="1">Present</td>
                <td rowspan="1" colspan="1">Present</td>
                <td rowspan="1" colspan="1">Present</td>
                <td rowspan="1" colspan="1">Present</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">Fever</td>
                <td rowspan="1" colspan="1">Common</td>
                <td rowspan="1" colspan="1">Common</td>
                <td rowspan="1" colspan="1">Rare unless infected</td>
                <td rowspan="1" colspan="1">Rare</td>
