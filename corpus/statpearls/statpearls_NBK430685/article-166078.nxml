                <td rowspan="1" colspan="1">Moderate</td>
                <td rowspan="1" colspan="1">Absent unless infected</td>
                <td rowspan="1" colspan="1">Absent</td>
                <td rowspan="1" colspan="1">Mild</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">CRP/ESR elevation</td>
                <td rowspan="1" colspan="1">Elevated</td>
                <td rowspan="1" colspan="1">Elevated</td>
                <td rowspan="1" colspan="1">Elevated</td>
                <td rowspan="1" colspan="1">Normal or mildly elevated</td>
                <td rowspan="1" colspan="1">Elevated</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">Urine culture</td>
                <td rowspan="1" colspan="1">Often positive</td>
                <td rowspan="1" colspan="1">Positive</td>
                <td rowspan="1" colspan="1">Usually negative</td>
                <td rowspan="1" colspan="1">Negative</td>
