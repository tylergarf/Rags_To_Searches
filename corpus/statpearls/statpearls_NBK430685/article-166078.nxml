<bold>Pyelonephritis</bold>
</td>
                <td rowspan="1" colspan="1">
<bold>Renal Cell Carcinoma</bold>
</td>
                <td rowspan="1" colspan="1">
<bold>Renal Infarction</bold>
</td>
