<p><bold>Adult Guidelines</bold></p>
</td>
                <td rowspan="1" colspan="1">
<p><bold>Pediatric Guidelines (American Academy of Pediatrics, 2011)</bold></p>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Total Cholesterol</bold></p>
</td>
                <td rowspan="1" colspan="1">
<p>&#x0003c;200 mg/dL optimal</p>
</td>
                <td rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>&#x0003c;170 mg/dL acceptable</p></list-item><list-item><p>&#x02265;200 mg/dL high</p></list-item></list>
</td>
