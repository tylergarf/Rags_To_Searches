    <back>
      <floats-group id="nurse-article-19888.s17">
        <fig id="nurse-article-19888.image.f1" position="float" orientation="portrait">
          <caption>
            <p>Viral conjunctivitis Image courtesy S Bhimji</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="conjunct" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-19888.s18">
        <fig id="nurse-article-19888.image.f2" position="float" orientation="portrait">
          <caption>
            <p>Keratoconjunctivitis. This image shows physical features consistent with&#x000a0;keratoconjunctivitis, including conjunctival injection, corneal ulcerations and opacities, and edema and marked erythema&#x000a0;of the eyelid margins. Image courtesy S Bhimji MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="keratoconjunctivitis" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-19888.s19">
        <fig id="nurse-article-19888.image.f3" position="float" orientation="portrait">
          <caption>
            <p>Bacterial Conjunctivitis.&#x000a0;The eye exhibits conjunctival hyperemia and mucopurulent discharge consistent with bacterial conjunctivitis. Contributed by&#x000a0;O Chaigasame, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="bacterial__conjuct" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-19888.s20">
        <fig id="nurse-article-19888.image.f4" position="float" orientation="portrait">
          <caption>
            <p>Follicular Conjunctivitis.&#x000a0;Inflammation is noted with viral infections like herpes zoster, Epstein-Barr virus infection, infectious mononucleosis, and chlamydial infections, as well as in reaction&#x000a0;to topical medications and molluscum contagiosum. Follicular conjunctivitis has been described in patients with COVID-19. The inferior and superior tarsal conjunctiva and the fornices show gray-white elevated swellings about 0.5 to 1 mm in diameter and have a velvety appearance. Contributed by Prof. BCK Patel MD, FRCS</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="Follicular__conjunctivitis-BCK__Patel__MD" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-19888.s21">
        <fig id="nurse-article-19888.image.f5" position="float" orientation="portrait">
          <caption>
            <p>Allergic Conjunctivitis Contributed by Katherine Humphreys</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="AllergicConjunctivitisOneEye" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
