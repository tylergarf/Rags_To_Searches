<bold>Ki-67 Index</bold>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">G1</td>
                <td rowspan="1" colspan="1">Well differentiated</td>
                <td rowspan="1" colspan="1">Low</td>
                <td rowspan="1" colspan="1">&#x0003c;2</td>
