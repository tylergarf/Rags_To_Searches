</bold>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">G1</td>
                <td rowspan="1" colspan="1">Well differentiated</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">G2</td>
