                <td style="width: 344px; height: 106px;" rowspan="1" colspan="1">Angiopoietin-like protein inhibitor</td>
                <td style="width: 269px; height: 106px;" rowspan="1" colspan="1">Evinacumab</td>
                <td style="width: 1434px; height: 106px;" rowspan="1" colspan="1">Inhibits ANGPTL3 (enhances lipoprotein lipase activity)</td>
                <td style="width: 2700.17px; height: 106px;" rowspan="1" colspan="1">&#x02193; LDL-C and &#x02193; TG</td>
