                <td style="width: 344px; height: 60.6667px;" rowspan="1" colspan="1">
<bold>Drug Class</bold>
</td>
                <td style="width: 269px; height: 60.6667px;" rowspan="1" colspan="1">
<bold>Key Representative Drugs</bold>
</td>
