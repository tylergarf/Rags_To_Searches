                <td style="width: 344px; height: 66px;" rowspan="1" colspan="1">Adenosine triphosphate-citrate lyase inhibitor</td>
                <td style="width: 269px; height: 66px;" rowspan="1" colspan="1">Bempedoic acid</td>
                <td style="width: 1434px; height: 66px;" rowspan="1" colspan="1">Inhibits ACL (upstream cholesterol synthesis)</td>
                <td style="width: 2700.17px; height: 66px;" rowspan="1" colspan="1">&#x02193; LDL-C</td>
                <td style="width: 840.833px; height: 66px;" rowspan="1" colspan="1">Established CVD or high risk, unable to take statins; primary hyperlipidemia, HeFH</td>
