                <td style="width: 344px; height: 66px;" rowspan="1" colspan="1">Microsomal triglyceride transfer protein inhibitor</td>
                <td style="width: 269px; height: 66px;" rowspan="1" colspan="1">Lomitapide mesylate</td>
                <td style="width: 1434px; height: 66px;" rowspan="1" colspan="1">Inhibits MTP (reduces VLDL/chylomicron assembly)</td>
                <td style="width: 2700.17px; height: 66px;" rowspan="1" colspan="1">&#x02193; LDL-C, &#x02193; total cholesterol and &#x02193; Apo B</td>
