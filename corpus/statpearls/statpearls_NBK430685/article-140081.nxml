                <td style="width: 160.484px; height: 56px;" rowspan="1" colspan="1">Pupillary block + iris bombe</td>
                <td style="width: 66.5156px; height: 56px;" rowspan="1" colspan="1">Shallow</td>
                <td style="width: 167px; height: 56px;" rowspan="1" colspan="1">Severe angle closure, pain, corneal edema</td>
              </tr>
              <tr style="height: 62.5715px;">
                <td style="width: 10px; height: 62.5715px;" rowspan="1" colspan="1">
<p><bold>Pupillary Block</bold><bold>&#x000a0;(Phacotopic)</bold></p>
</td>
                <td style="width: 169px; height: 62.5715px;" rowspan="1" colspan="1">
<p>Lens subluxation/dislocation</p>
</td>
                <td style="width: 160.484px; height: 62.5715px;" rowspan="1" colspan="1">
<p>Pupillary block or angle obstruction</p>
</td>
                <td style="width: 66.5156px; height: 62.5715px;" rowspan="1" colspan="1">
<p>Variable</p>
</td>
