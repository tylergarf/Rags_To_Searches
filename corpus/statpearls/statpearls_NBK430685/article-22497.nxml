</td>
                <td style="width: 148px; height: 13px;" rowspan="1" colspan="1">
<bold>&#x000a0;Hallux Valgus Angle</bold>
</td>
                <td style="width: 200.304px; height: 13px;" rowspan="1" colspan="1">
<bold>Intermetatarsal Angle</bold>
</td>
              </tr>
              <tr style="height: 13px;">
                <td style="width: 79px; height: 13px;" rowspan="1" colspan="1">
<bold>Normal&#x000a0;</bold>
</td>
                <td style="width: 148px; height: 13px;" rowspan="1" colspan="1">&#x0003c;15&#x000b0;</td>
                <td style="width: 200.304px; height: 13px;" rowspan="1" colspan="1">&#x0003c;9&#x000b0;</td>
              </tr>
