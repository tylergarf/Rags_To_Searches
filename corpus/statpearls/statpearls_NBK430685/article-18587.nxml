            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://mdsearchlight.com/health/new-breast-mass/?utm_source=pubmedlink&#x00026;utm_campaign=MDS&#x00026;utm_content=18587">Click here for a simplified version.</ext-link>
</p>
          </list-item>
