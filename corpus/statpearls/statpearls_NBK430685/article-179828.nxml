</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Depression</bold></p>
</td>
                <td rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Stable on current therapy</p></list-item></list>
</td>
                <td rowspan="1" colspan="1">
