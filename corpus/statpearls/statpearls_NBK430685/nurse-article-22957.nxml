        <list list-type="bullet">
          <list-item>
            <p>Do not smoke</p>
          </list-item>
          <list-item>
            <p>Avoid alcohol</p>
          </list-item>
          <list-item>
            <p>Wash hands</p>
          </list-item>
          <list-item>
            <p>Wash foods</p>
          </list-item>
          <list-item>
            <p>Get immunized</p>
          </list-item>
          <list-item>
            <p>Avoid crowds during treatment</p>
          </list-item>
          <list-item>
            <p>Follow up with oncologist</p>
          </list-item>
          <list-item>
            <p>Eat healthy</p>
          </list-item>
