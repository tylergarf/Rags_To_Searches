<p><bold>Treatment options</bold></p>
</td>
              </tr>
              <tr>
                <td style="width: 240.525px;" rowspan="1" colspan="1">
<p><bold>Immune TTP</bold></p>
</td>
                <td style="width: 303.342px;" rowspan="1" colspan="1">
<p>Therapeutic plasma exchange&#x000a0;</p>
<p>Immunosuppression</p>
<p>Caplacizumab</p>
</td>
              </tr>
              <tr>
                <td style="width: 240.525px;" rowspan="1" colspan="1">
<p><bold>Congenital TTP</bold></p>
</td>
                <td style="width: 303.342px;" rowspan="1" colspan="1">
<p>Fresh frozen plasma</p>
<p>Therapeutic plasma exchange</p>
<p>Recombinant <italic toggle="yes">ADAMTS13</italic>&#x000a0;<xref ref-type="bibr" rid="article-169704.r36">[36]</xref></p>
</td>
              </tr>
              <tr>
                <td style="width: 240.525px;" rowspan="1" colspan="1">
<p><bold>Complement-mediated TMA</bold></p>
</td>
