    <back>
      <ref-list id="article-38202.s12">
        <title>References</title>
        <ref id="article-38202.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Song</surname>
                <given-names>LL</given-names>
              </name>
              <name>
                <surname>Li</surname>
                <given-names>YM</given-names>
              </name>
