            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/20367/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=20367">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
