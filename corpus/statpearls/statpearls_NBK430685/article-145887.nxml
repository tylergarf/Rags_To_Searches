                <td style="width: 153px; height: 13px;" rowspan="1" colspan="1">-</td>
                <td style="width: 74px; height: 13px;" rowspan="1" colspan="1">3+ or 4+</td>
                <td style="width: 201.115px; height: 13px;" rowspan="1" colspan="1">3+ or 4+</td>
                <td style="width: 10px; height: 13px;" rowspan="1" colspan="1">-</td>
              </tr>
