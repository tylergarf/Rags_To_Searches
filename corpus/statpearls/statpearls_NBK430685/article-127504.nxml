                <td style="width: 123.156px; height: 13px;" rowspan="1" colspan="1">&#x02265;10 mIU/mL</td>
                <td style="width: 123.156px; height: 13px;" rowspan="1" colspan="1">No action needed</td>
                <td style="width: 123.156px; height: 13px;" rowspan="1" colspan="1">No action needed</td>
                <td style="width: 123.219px; height: 13px;" rowspan="1" colspan="1">No action needed</td>
              </tr>
              <tr style="height: 39px;">
