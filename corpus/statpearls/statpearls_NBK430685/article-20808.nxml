</td>
                <td rowspan="1" colspan="1">
<bold>Physiologic Function</bold>
</td>
                <td rowspan="1" colspan="1">
<bold>Clinical Relevance</bold>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<bold>Central neural drive</bold>
</td>
