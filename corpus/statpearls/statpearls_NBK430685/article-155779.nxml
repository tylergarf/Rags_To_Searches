<bold>Recommended Follow-up</bold>
</td>
              </tr>
              <tr style="height: 26px;">
                <td style="height: 26px;" rowspan="1" colspan="1">
<italic toggle="yes">Neisseria gonorrhoeae</italic>
</td>
                <td style="height: 26px;" rowspan="1" colspan="1">Gonorrhoea</td>
