            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/26498/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=26498">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
    </body>
    <back>
      <ref-list id="article-26498.s11">
        <title>References</title>
        <ref id="article-26498.r1">
          <label>1</label>
