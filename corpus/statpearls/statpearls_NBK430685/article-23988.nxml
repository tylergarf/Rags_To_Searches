              </name>
            </person-group>
            <article-title>Perilymphatic fistula: a New Hampshire experience.</article-title>
            <source>Am J Otol</source>
            <year>1988</year>
            <month>May</month>
            <volume>9</volume>
            <issue>3</issue>
            <fpage>184</fpage>
            <page-range>184-96</page-range>
            <pub-id pub-id-type="pmid">3177601</pub-id>
          </element-citation>
        </ref>
        <ref id="article-23988.r2">
          <label>2</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>McCabe</surname>
                <given-names>BF</given-names>
              </name>
