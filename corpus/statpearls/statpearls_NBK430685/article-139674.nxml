      <floats-group id="article-139674.s25">
        <fig id="article-139674.image.f2" position="float" orientation="portrait">
          <caption>
            <p>Intermittent Exotropia. The video demonstrates a 5-year-old female patient with intermittent exotropia, showing good control as evidenced by rapid refixation during the alternate cover test. Contributed by K Kaur, MBBS, DNB, FPOS, FICO, MRCS Ed, MNAMS</p>
          </caption>
          <media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="VID_20210908225923.mp4" mime-subtype="mp4" position="float" orientation="portrait"/>
