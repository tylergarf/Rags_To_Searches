<bold>Stages</bold>
</td>
                <td style="width: 346.556px;" rowspan="1" colspan="1">
<bold>Clinical Features</bold>
</td>
              </tr>
              <tr>
                <td style="width: 35px;" rowspan="1" colspan="1">1</td>
                <td style="width: 346.556px;" rowspan="1" colspan="1">Avascular periphery or anomalous intraretinal vascularization</td>
              </tr>
              <tr>
                <td style="width: 35px;" rowspan="1" colspan="1">1A</td>
                <td style="width: 346.556px;" rowspan="1" colspan="1">Without exudate or leakage</td>
              </tr>
              <tr>
                <td style="width: 35px;" rowspan="1" colspan="1">1B</td>
                <td style="width: 346.556px;" rowspan="1" colspan="1">With exudate or leakage</td>
              </tr>
              <tr>
                <td style="width: 35px;" rowspan="1" colspan="1">2</td>
