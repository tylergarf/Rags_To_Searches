    <back>
      <ref-list id="article-21669.s11">
        <title>References</title>
        <ref id="article-21669.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Leitch</surname>
                <given-names>B</given-names>
              </name>
            </person-group>
            <article-title>Molecular Mechanisms Underlying the Generation of Absence Seizures: Identification of Potential Targets for Therapeutic Intervention.</article-title>
            <source>Int J Mol Sci</source>
