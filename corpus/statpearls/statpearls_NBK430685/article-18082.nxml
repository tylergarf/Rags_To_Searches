            <article-title>Babesiosis-associated Splenic Rupture: Case Series From a Hyperendemic Region.</article-title>
            <source>Clin Infect Dis</source>
            <year>2019</year>
            <month>Sep</month>
            <day>13</day>
            <volume>69</volume>
            <issue>7</issue>
