</p>
        <list list-type="bullet">
          <list-item>
            <p>Chronic viral hepatitis&#x000a0;</p>
          </list-item>
          <list-item>
            <p>Alcohol-associated liver disease</p>
          </list-item>
          <list-item>
            <p>Hemochromatosis</p>
          </list-item>
