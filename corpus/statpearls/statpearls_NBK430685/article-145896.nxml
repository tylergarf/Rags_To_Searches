                <td style="width: 143.406px; height: 77.3334px; vertical-align: middle;" rowspan="1" colspan="1">Alkaline phosphatase (ALP)&#x000a0;<xref ref-type="bibr" rid="article-145896.r24">[24]</xref></td>
                <td style="width: 143.406px; height: 22px;" rowspan="1" colspan="1">Alpha-1 ALP</td>
