      <ref-list id="article-27343.s20">
        <title>References</title>
        <ref id="article-27343.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>&#x000c1;lvarez-Holzapfel</surname>
                <given-names>MJ</given-names>
              </name>
              <name>
                <surname>Aibar Dur&#x000e1;n</surname>
