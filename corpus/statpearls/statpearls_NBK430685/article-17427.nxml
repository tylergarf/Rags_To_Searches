<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://mdsearchlight.com/eye-health/amaurosis-fugax-transient-visual-loss-tvl/?utm_source=pubmedlink&#x00026;utm_campaign=MDS&#x00026;utm_content=17427">Click here for a simplified version.</ext-link>
