      <floats-group id="article-183.s9">
        <fig id="article-183.image.f2" position="float" orientation="portrait">
          <caption>
            <p>Transthoracic Echocardiogram of a Patient With Reverse Takotsubo Syndrome. The video depicts elevated cardiac enzymes and normal epicardial coronary arteries. Contributed by P Shams, MBBS, FCPS</p>
          </caption>
          <media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="Video__1-Reverse__Takotsubo-high.mp4" mime-subtype="mp4" position="float" orientation="portrait"/>
