<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://mdsearchlight.com/hormones-and-body-chemistry/thyroid-disease-and-pregnancy/?utm_source=pubmedlink&#x00026;utm_campaign=MDS&#x00026;utm_content=36235">Click here for a simplified version.</ext-link>
