      <ref-list id="article-150330.s25">
        <title>References</title>
        <ref id="article-150330.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Li</surname>
                <given-names>S</given-names>
              </name>
              <name>
                <surname>Mohamedi</surname>
                <given-names>AH</given-names>
