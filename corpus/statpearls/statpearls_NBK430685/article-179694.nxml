</td>
                <td rowspan="1" colspan="1">
<p>Decreased 15% to 20%</p>
</td>
                <td rowspan="1" colspan="1">
<p>Increased 20% to 25%</p>
</td>
                <td rowspan="1" colspan="1">
<p>Delayed peak</p>
</td>
                <td rowspan="1" colspan="1">
<p>18% obesity risk increase</p>
</td>
