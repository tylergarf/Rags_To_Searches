</td>
                <td rowspan="1" colspan="1">
<p>Early if symptoms present</p>
</td>
                <td rowspan="1" colspan="1">
<p>Sleep disorder treatment</p>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Psychiatrist</bold></p>
</td>
                <td rowspan="1" colspan="1">
