<p><bold>Advanced Level</bold></p>
</td>
                <td rowspan="1" colspan="1">
<p><bold>Clinical Modifications</bold></p>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Frequency</bold></p>
</td>
                <td rowspan="1" colspan="1">
