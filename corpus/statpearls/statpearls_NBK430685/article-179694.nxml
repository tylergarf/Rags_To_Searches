<p>50% to 60% 1-rep max</p>
</td>
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>60% to 75% 1-rep max</p>
</td>
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>70% to 85% 1-rep max</p>
</td>
              </tr>
              <tr style="height: 35px;">
