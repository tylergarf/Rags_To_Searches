<p><bold>Intensity</bold></p>
</td>
                <td style="width: 134.205px;" rowspan="1" colspan="1">
<p><bold>Specific Recommendations</bold></p>
</td>
              </tr>
              <tr>
                <td style="width: 103px;" rowspan="1" colspan="1">
<p><bold>Aerobic Activity</bold></p>
</td>
                <td style="width: 72px;" rowspan="1" colspan="1">
