              <tr>
                <td rowspan="1" colspan="1">
<p><bold>7&#x02013;9 hours</bold></p>
</td>
                <td rowspan="1" colspan="1">
<p>Normal</p>
</td>
                <td rowspan="1" colspan="1">
<p>Normal</p>
</td>
                <td rowspan="1" colspan="1">
<p>Normal circadian rhythm</p>
</td>
                <td rowspan="1" colspan="1">
