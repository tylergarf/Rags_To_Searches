                <td style="height: 75px;" rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Pregnancy</p></list-item><list-item><p>High altitude</p></list-item><list-item><p>Stress</p></list-item><list-item><p>Pain</p></list-item></list>
</td>
              </tr>
              <tr style="height: 35px;">
                <td style="height: 35px;" rowspan="1" colspan="1">Iatrogenic</td>
                <td style="height: 35px;" rowspan="1" colspan="1">
