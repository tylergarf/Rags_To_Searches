<list list-type="bullet"><list-item><p>Asthma and COPD</p></list-item><list-item><p>Pneumonia</p></list-item><list-item><p>Pulmonary fibrosis</p></list-item><list-item><p>Pulmonary edema</p></list-item><list-item><p>Pulmonary embolism</p></list-item><list-item><p>Pulmonary vascular disease</p></list-item><list-item><p>Interstitial pneumonitis</p></list-item><list-item><p>Pneumothorax</p></list-item></list>
