                <td style="width: 128.568px;" rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Bitot spots</p></list-item><list-item><p>Corneal drying</p></list-item></list>
</td>
                <td style="width: 102px;" rowspan="1" colspan="1">
