<bold>Muscle</bold>
</td>
                <td style="height: 13px;" rowspan="1" colspan="1">
<bold>Origin</bold>
</td>
                <td style="height: 13px;" rowspan="1" colspan="1">
<bold>Insertion</bold>
</td>
                <td style="height: 13px;" rowspan="1" colspan="1">
<bold>Action(s)</bold>
</td>
              </tr>
              <tr style="height: 39px;">
                <td style="height: 39px;" rowspan="1" colspan="1">
<bold>Temporalis</bold>
</td>
                <td style="height: 39px;" rowspan="1" colspan="1">Temporal fossa floor and the deep temporal fascia</td>
