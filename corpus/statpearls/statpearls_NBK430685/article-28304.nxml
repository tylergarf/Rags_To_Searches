              </tr>
              <tr>
                <td style="width: 137.284px;" rowspan="1" colspan="1">
<bold>Lansoprazole</bold>
</td>
                <td style="width: 143.716px;" rowspan="1" colspan="1">30 mg once daily</td>
                <td style="width: 148px;" rowspan="1" colspan="1">30 mg&#x000a0;twice daily</td>
                <td style="width: 205px;" rowspan="1" colspan="1">0.90</td>
              </tr>
              <tr>
                <td style="width: 137.284px;" rowspan="1" colspan="1">
<bold>Pantoprazole</bold>
</td>
                <td style="width: 143.716px;" rowspan="1" colspan="1">40 mg once daily</td>
                <td style="width: 148px;" rowspan="1" colspan="1">40 mg twice daily</td>
                <td style="width: 205px;" rowspan="1" colspan="1">0.23</td>
              </tr>
              <tr>
                <td style="width: 137.284px;" rowspan="1" colspan="1">
<bold>Rabeprazole</bold>
</td>
                <td style="width: 143.716px;" rowspan="1" colspan="1">20 mg once daily</td>
                <td style="width: 148px;" rowspan="1" colspan="1">20 mg twice daily</td>
                <td style="width: 205px;" rowspan="1" colspan="1">1.82</td>
              </tr>
              <tr>
                <td style="width: 137.284px;" rowspan="1" colspan="1">
<bold>Esomeprazole</bold>
</td>
                <td style="width: 143.716px;" rowspan="1" colspan="1">20 mg once daily</td>
                <td style="width: 148px;" rowspan="1" colspan="1">40 mg once daily</td>
                <td style="width: 205px;" rowspan="1" colspan="1">1.60</td>
              </tr>
              <tr>
                <td style="width: 137.284px;" rowspan="1" colspan="1">
<bold>Dexlansoprazole</bold>
</td>
