      <floats-group id="article-20770.s16">
        <fig id="article-20770.image.f1" position="float" orientation="portrait">
          <caption>
            <p>Duret Hemorrhage, Computed Tomography Scan. Duret hemorrhages are small areas of bleeding in the brainstem, primarily attributed to descending transtentorial herniation, which occurs due to increased intracranial pressure and resultant intracranial compartmental shifts. Contributed by S Lange, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="Duret__hemorrhage" position="float" orientation="portrait"/>
