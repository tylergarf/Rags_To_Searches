<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/23170/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=23170">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
    </body>
    <back>
      <ref-list id="article-23170.s18">
        <title>References</title>
        <ref id="article-23170.r1">
          <label>1</label>
          <element-citation publication-type="journal">
