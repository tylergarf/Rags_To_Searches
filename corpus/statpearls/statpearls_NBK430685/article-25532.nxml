      <floats-group id="article-25532.s22">
        <fig id="article-25532.image.f5" position="float" orientation="portrait">
          <caption>
            <p>Halo Sign Indicating Cerebrospinal Fluid Leakage. The halo sign is a double-ring pattern that appears when bloody fluid from the ear or nose, containing cerebrospinal fluid, is dripped onto linen or paper. Contributed by R Winters, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="IMG_0183" position="float" orientation="portrait"/>
