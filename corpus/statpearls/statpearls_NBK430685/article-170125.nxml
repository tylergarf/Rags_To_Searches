<bold>Perioperative Stroke and Death Risk</bold>
</td>
              </tr>
              <tr style="height: 26px;">
                <td style="height: 26px; width: 226px;" rowspan="1" colspan="1">Asymptomatic Carotid Atherosclerosis Study (ACAS)</td>
                <td style="height: 26px; width: 46px;" rowspan="1" colspan="1">1995</td>
                <td style="height: 26px; width: 107.292px;" rowspan="1" colspan="1">5.1% for CEA vs 11% BMT</td>
                <td style="height: 26px; width: 139.708px;" rowspan="1" colspan="1">2.3% <xref ref-type="bibr" rid="article-170125.r45">[45]</xref></td>
              </tr>
