              </tr>
              <tr style="height: 13px;">
                <td style="width: 98px; height: 13px;" rowspan="1" colspan="1">Canada</td>
                <td style="width: 318.927px; height: 13px;" rowspan="1" colspan="1">Accessibility for Ontarians with Disabilities Act</td>
                <td style="width: 78.0729px; height: 13px;" rowspan="1" colspan="1">2005</td>
              </tr>
              <tr style="height: 13px;">
                <td style="width: 98px; height: 13px;" rowspan="1" colspan="1">Canada</td>
                <td style="width: 318.927px; height: 13px;" rowspan="1" colspan="1">Accessibility for Manitobans Act</td>
                <td style="width: 78.0729px; height: 13px;" rowspan="1" colspan="1">2013</td>
              </tr>
