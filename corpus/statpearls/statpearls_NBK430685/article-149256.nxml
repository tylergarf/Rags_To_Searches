</td>
                <td style="width: 318.927px; height: 13px;" rowspan="1" colspan="1">
<bold>Name of Act</bold>
</td>
                <td style="width: 78.0729px; height: 13px;" rowspan="1" colspan="1">
<bold>Year Enacted</bold>
</td>
              </tr>
              <tr style="height: 13px;">
                <td style="width: 98px; height: 13px;" rowspan="1" colspan="1">Japan</td>
                <td style="width: 318.927px; height: 13px;" rowspan="1" colspan="1">Act for the Welfare of Persons with Disabilities</td>
                <td style="width: 78.0729px; height: 13px;" rowspan="1" colspan="1">1970</td>
              </tr>
              <tr style="height: 13px;">
                <td style="width: 98px; height: 13px;" rowspan="1" colspan="1">United States</td>
                <td style="width: 318.927px; height: 13px;" rowspan="1" colspan="1">Americans with Disabilities Act</td>
