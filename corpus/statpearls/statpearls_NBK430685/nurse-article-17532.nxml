      <floats-group id="nurse-article-17532.s20">
        <fig id="nurse-article-17532.image.f3" position="float" orientation="portrait">
          <caption>
            <p>Normal Versus Iron Deficiency Anemia. The image shows a comparison of normal red blood cells and microcytic, hypochromic red blood cells in iron deficiency anemia, characterized by increased central pallor and variability in size and shape. Contributed by&#x000a0;S Bhimji, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="irondeficiency" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-17532.s21">
        <fig id="nurse-article-17532.image.f4" position="float" orientation="portrait">
          <caption>
            <p>Sideroblastic Anemia. There are different forms of sideroblastic anemia, and all forms are defined by the presence of ring sideroblasts in the bone marrow, shown in the image. Contributed by&#x000a0;S Bhimji, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="sideroblasts" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
      <floats-group id="nurse-article-17532.s22">
        <fig id="nurse-article-17532.image.f5" position="float" orientation="portrait">
          <caption>
            <p>Hypochromic Microcytic Anemia Image courtesy S Bhimji MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="pure__red__cell__aplasia" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
